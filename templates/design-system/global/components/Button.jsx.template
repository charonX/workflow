import React from 'react';

/**
 * Button — {{PROJECT_NAME}} 的主按钮组件。
 */
export function Button({ variant = 'primary', size = 'md', disabled = false, children, onClick }) {
  return (
    <button
      className={`ds-btn ds-btn-${variant} ds-btn-${size}`}
      disabled={disabled}
      onClick={onClick}
    >
      {children}
    </button>
  );
}
