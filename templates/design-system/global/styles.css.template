/* 工具类示例 —— 可删除或扩展为完整工具类 */
.ds-surface {
  background-color: var(--color-surface);
  color: var(--color-text);
}

.ds-stack > * + * {
  margin-block-start: var(--space-4);
}

.ds-card {
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-sm);
  padding: var(--space-4);
}
