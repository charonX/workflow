/* {{PROJECT_NAME}} Design Tokens */
/* 这是项目级设计系统的 CSS token 入口。请保持 :root 内的自定义属性可被 ds-core 解析。 */
/* 使用 /* @kind color|font|spacing|radius|shadow|z|motion|other */ 注释帮助 checker 分类 token。 */

:root {
  /* @kind color */
  --color-primary: #3366ff;
  --color-primary-hover: #254ecc;
  --color-surface: #ffffff;
  --color-background: #f6f7f9;
  --color-text: #111827;
  --color-text-muted: #6b7280;
  --color-border: #e5e7eb;
  --color-success: #10b981;
  --color-warning: #f59e0b;
  --color-error: #ef4444;

  /* @kind font */
  --font-family-base: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; /* @kind font */
  --font-family-display: "Inter", sans-serif; /* @kind font */
  --font-size-xs: 0.75rem;   /* @kind font */
  --font-size-sm: 0.875rem;  /* @kind font */
  --font-size-base: 1rem;    /* @kind font */
  --font-size-lg: 1.125rem;  /* @kind font */
  --font-size-xl: 1.25rem;   /* @kind font */
  --font-size-2xl: 1.5rem;   /* @kind font */
  --font-weight-normal: 400; /* @kind font */
  --font-weight-medium: 500; /* @kind font */
  --font-weight-bold: 700;   /* @kind font */
  --line-height-tight: 1.25; /* @kind font */
  --line-height-normal: 1.5; /* @kind font */

  /* @kind spacing */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: 1.25rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --space-10: 2.5rem;
  --space-12: 3rem;

  /* @kind radius */
  --radius-sm: 0.25rem;
  --radius-md: 0.5rem;
  --radius-lg: 0.75rem;
  --radius-xl: 1rem;
  --radius-full: 9999px;

  /* @kind shadow */
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);

  /* @kind z */
  --z-base: 0;
  --z-dropdown: 100;
  --z-sticky: 200;
  --z-modal: 300;
  --z-toast: 400;

  /* @kind motion */
  --duration-fast: 150ms;
  --duration-normal: 250ms;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}

@media (prefers-color-scheme: dark) {
  :root {
    --color-surface: #111827;
    --color-background: #0b0f19;
    --color-text: #f9fafb;
    --color-text-muted: #9ca3af;
    --color-border: #374151;
  }
}
